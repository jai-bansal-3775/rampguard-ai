{
 "rule_version": "rules-1.3",
 "default_model": "gemini-3.5-flash-lite",
  "gate": {
    "id": "C22",
    "camera": "CAM-C22-01",
    "clearance_m": 3,
    "zone_definition": "area within the configured clearance of the fuselage, engines and fuel points"
  },
  "thresholds": {
    "min_confidence": 0.6,
    "low_confidence": 0.75,
    "phase_confidence": 0.6,
    "single_frame_min_confidence": 0.8,
    "persistence_frames": 2,
    "suppress_minutes": 10,
    "single_frame_max_severity": "High",
    "verify": true
  },
  "severities": [
    "Low",
    "Medium",
    "High",
    "Critical"
  ],
  "phases": [
    "Aircraft Arrival",
    "Baggage Handling",
    "Catering",
    "Fueling",
    "Boarding",
    "Turnaround Completion",
    "Pushback Preparation"
  ],
  "object_types": [
    "gse",
    "person",
    "aircraft",
    "obstruction",
    "hazard"
  ],
  "gse_kinds": [
